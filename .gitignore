# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
env/

# ── 构建产物 ──────────────────────────────────────────────────────────────
# build/ 里放的是 csc 编译出来的原生启动器（源码在 launcher/Launcher.cs，
# 8 KB 左右的 .NET 程序集）。它体积小、可直接双击用，因此**保留进仓库**。
# build/<name>/ 是 PyInstaller 的中间工作目录（toc/pyz/pkg，上 MB），
# 可随时重建，不进仓库。
build/*/
dist/
*.spec

# ── 运行时产物 ────────────────────────────────────────────────────────────
# 每台机器的窗口/进程名都不一样，个人配置不进仓库
config/targets.json
config/*.tmp
config/selftest.json
artifacts/*.reg
artifacts/sac_disable_log.txt
*.tmp

# ── 本地调试截图（保留 README 引用的两张）─────────────────────────────────
artifacts/*.log
artifacts/*_raw.png

# ── 编辑器 / 系统 ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
